// un damier), plus un bruit lent ; tout défile le long du courant de `defile`.
float hauteur_vagues(vec2 p, vec2 flux, float defile, float t) {
	vec2 n = vec2(-flux.y, flux.x);
	vec2 q = vec2(dot(p, n), dot(p, flux) - defile);
