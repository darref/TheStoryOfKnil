			float fondu = smoothstep(0.0, 0.08, min(bord.x, bord.y)) * (1.0 - float(i) / 48.0);
			return vec4(textureLod(tex_ecran, uv, 0.0).rgb, fondu);
		}
	}
	return vec4(0.0);
}


