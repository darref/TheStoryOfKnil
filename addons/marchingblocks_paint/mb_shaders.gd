	// éparses (vu à l'image, poids du reflet peint en rouge) ; l'éclat du soleil, lui, garde les vagues entières.
	vec3 n_miroir = normalize(mix((VIEW_MATRIX * vec4(0.0, 1.0, 0.0, 0.0)).xyz, nv, aplati));
