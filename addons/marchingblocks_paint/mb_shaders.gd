@tool
extends RefCounted
## The MarchingBlocks tool's own shaders, for this plugin: animated textures, transitions between layers, the
## wind in the foliage, and the six water looks.
##
## GENERATED by DEV_TOOLS/generer_shaders_greffon.gd from the MarchingBlocks tool's shaders — do not edit by hand,
## the tool's are the source. Two changes only: `mb_world_to_format` (FORMAT space, where the tool's world IS that
## space) in ANIMATION and TRANSITIONS, and one clock (Godot's TIME) in ANIMATION.

## The water look exported in world.json → its shader below (an unknown look: the first one).
const WATER_LOOKS := ["stylized","clear","reflective","lava","swamp","acid"]

const ANIMATION := """
shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_burley, specular_schlick_ggx;
uniform mat4 mb_world_to_format = mat4(1.0);

#define mb_temps TIME
const int mb_image = -1;

uniform vec4 couleur : source_color = vec4(1.0);
uniform float rugosite : hint_range(0.0, 1.0) = 0.8;
uniform float metal : hint_range(0.0, 1.0) = 0.0;
uniform float force_emission = 1.0;
uniform bool a_normale = false;
uniform bool a_orm = false;
uniform bool a_ao = false;
uniform bool a_emission = false;
// x : fréquence (Hz, 0 = aucune), y : la force au creux, z : 1 synchro, 0 décalée
uniform vec3 pulsation = vec3(0.0, 1.0, 1.0);


uniform sampler2D albedo_fixe : source_color, hint_default_white, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2DArray albedo_images : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform ivec4 albedo_reglages = ivec4(0, 0, 1, 1);
uniform vec4 albedo_mouvement = vec4(0.0, 0.0, 12.0, 1.0);

uniform sampler2D normale_fixe : hint_normal, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2DArray normale_images : filter_linear_mipmap_anisotropic, repeat_enable;
uniform ivec4 normale_reglages = ivec4(0, 0, 1, 1);
uniform vec4 normale_mouvement = vec4(0.0, 0.0, 12.0, 1.0);

uniform sampler2D orm_fixe : hint_default_white, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2DArray orm_images : filter_linear_mipmap_anisotropic, repeat_enable;
uniform ivec4 orm_reglages = ivec4(0, 0, 1, 1);
uniform vec4 orm_mouvement = vec4(0.0, 0.0, 12.0, 1.0);

uniform sampler2D emission_fixe : source_color, hint_default_black, filter_linear_mipmap_anisotropic, repeat_enable;
uniform sampler2DArray emission_images : source_color, filter_linear_mipmap_anisotropic, repeat_enable;
uniform ivec4 emission_reglages = ivec4(0, 0, 1, 1);
uniform vec4 emission_mouvement = vec4(0.0, 0.0, 12.0, 1.0);


varying float phase;

// LA PHASE D'UNE COPIE, tirée de sa position (`phase_de`, ligne à ligne).
float hacher(vec3 o) {
	vec3 p = floor(o + 0.5);
	p = fract(p * 0.3183099 + vec3(0.71, 0.113, 0.419)) * 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

void vertex() {
	phase = hacher(((mb_world_to_format * MODEL_MATRIX) * vec4(0.0, 0.0, 0.0, 1.0)).xyz);
}

// L'IMAGE AU TEMPS (`image_au_temps`, ligne à ligne). r.x : nombre d'images, r.y : aller-retour, r.z : synchro.
int image_de(ivec4 r, float ips) {
	int n = r.x;
	if (n <= 0) {
		return 0;
	}
	if (mb_image >= 0) {
		return mb_image % n;
	}
	int k = int(floor(mb_temps * ips + (r.z != 0 ? 0.0 : phase * float(n))));
	if (r.y != 0 && n > 1) {
		int p = 2 * n - 2;
		k = k % p;
		return k < n ? k : p - k;
	}
	return k % n;
}

vec4 lire(sampler2D fixe, sampler2DArray imgs, ivec4 r, vec4 m, vec2 uv) {
	// m.xy : vitesse du défilement, m.z : images par seconde, m.w : défilement synchro (1) ou décalé (0)
	vec2 u = uv + m.xy * (mb_temps + (m.w > 0.5 ? 0.0 : phase * 7.0));
	if (r.x > 0) {
		return texture(imgs, vec3(u, float(image_de(r, m.z))));
	}
	return texture(fixe, u);
}

void fragment() {
	vec4 a = lire(albedo_fixe, albedo_images, albedo_reglages, albedo_mouvement, UV);
	ALBEDO = couleur.rgb * a.rgb;
	float r = rugosite;
	float mt = metal;
	if (a_orm) {
		vec4 o = lire(orm_fixe, orm_images, orm_reglages, orm_mouvement, UV);
		r *= o.g;
		mt *= o.b;
		if (a_ao) {
			AO = o.r;
		}
	}
	ROUGHNESS = r;
	METALLIC = mt;
	if (a_normale) {
		NORMAL_MAP = lire(normale_fixe, normale_images, normale_reglages, normale_mouvement, UV).rgb;
	}
	if (a_emission) {
		float p = 1.0;
		if (pulsation.x > 0.0) {
			float t = mb_temps * pulsation.x + (pulsation.z > 0.5 ? 0.0 : phase);
			p = mix(pulsation.y, 1.0, 0.5 + 0.5 * cos(TAU * t));
		}
		EMISSION = lire(emission_fixe, emission_images, emission_reglages, emission_mouvement, UV).rgb * force_emission * p;
	}
}
"""

const TRANSITIONS := """
shader_type spatial;
render_mode blend_mix, depth_draw_never, cull_back;
uniform mat4 mb_world_to_format = mat4(1.0);

uniform sampler3D cases : filter_nearest, repeat_disable;
uniform ivec3 origine;
uniform ivec3 taille;
uniform sampler2D table : filter_nearest, repeat_disable;
uniform sampler2DArray representants : source_color, filter_linear_mipmap, repeat_enable;
// Les réglages des représentants (21 octobre 2026, au lieu de trois tableaux de 15) : (k, 0) la couleur de la couche k,
// (k, 1) x l'échelle, y la rugosité — une texture, comme dans Unity et Unreal, dimensionnée sur le nombre de couches.
uniform sampler2D rep_params : filter_nearest, repeat_disable;
uniform bool montrer_choix = false;

varying vec3 p_monde;
varying vec3 n_monde;
varying flat vec3 centre;

void vertex() {
	p_monde = ((mb_world_to_format * MODEL_MATRIX) * vec4(VERTEX, 1.0)).xyz;
	n_monde = normalize(((mb_world_to_format * MODEL_MATRIX) * vec4(NORMAL, 0.0)).xyz);
	centre = (mb_world_to_format * MODEL_MATRIX)[3].xyz;
	vec4 vue = MODELVIEW_MATRIX * vec4(VERTEX, 1.0);
	if (PROJECTION_MATRIX[3][3] == 0.0) {
		vue.xyz *= 1.0 - 2e-4;
	} else {
		vue.z += 0.002;
	}
	POSITION = PROJECTION_MATRIX * vue;
}

float hache(vec3 p) {
	p = fract(p * 0.3183099 + vec3(0.11, 0.17, 0.13));
	p *= 17.0;
	return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float bruit3(vec3 x) {
	vec3 i = floor(x);
	vec3 f = fract(x);
	f = f * f * (3.0 - 2.0 * f);
	return mix(mix(mix(hache(i), hache(i + vec3(1, 0, 0)), f.x), mix(hache(i + vec3(0, 1, 0)), hache(i + vec3(1, 1, 0)), f.x), f.y),
		mix(mix(hache(i + vec3(0, 0, 1)), hache(i + vec3(1, 0, 1)), f.x), mix(hache(i + vec3(0, 1, 1)), hache(i + vec3(1, 1, 1)), f.x), f.y), f.z);
}

vec4 aspect(int k, vec3 p, vec3 n) {
	vec3 w = pow(abs(n), vec3(4.0));
	w /= (w.x + w.y + w.z);
	float e = max(texelFetch(rep_params, ivec2(k, 1), 0).x, 0.01);
	vec4 c = texture(representants, vec3(p.zy / e, float(k))) * w.x
		+ texture(representants, vec3(p.xz / e, float(k))) * w.y
		+ texture(representants, vec3(p.xy / e, float(k))) * w.z;
	return c * texelFetch(rep_params, ivec2(k, 0), 0);
}

float visible(vec4 p1, vec4 p2, float s_c, float h, float n) {
	float decalage = (p1.b + p2.r * (0.5 - h) + p1.a * (n - 0.5)) * 4.0 * s_c * (1.0 - s_c);
	return smoothstep(0.5 - p1.g * 0.5, 0.5 + p1.g * 0.5, s_c + decalage);
}

int rang_en(ivec3 c, int canal) {
	ivec3 t = c - origine;
	if (t.x < 0 || t.y < 0 || t.z < 0 || t.x >= taille.x || t.y >= taille.y || t.z >= taille.z) {
		return -1;
	}
	vec4 v = texelFetch(cases, t, 0);
	return int(round((canal == 0 ? v.r : v.g) * 255.0)) - 1;
}

void fragment() {
	// ⚠ LE SOMMET DE LA TUILE, PAS CELUI DU POINT (vu à l'image : des pointillés clairs à chaque joint de la bande) : sur le bord
	// d'une tuile, floor(p − ½) bascule dans la maille de la voisine, le passage s'y jette, et la tuile native transparaît. La
	// tuile du sommet v est posée en v + 1 (son centre) : on le lit dans sa matrice, et le point est borné à sa maille (un
	// relief qui déborde de sa case, règle (A), prend la couleur de son bord). ⚠ LU DANS vertex() : dans fragment(), la
	// (mb_world_to_format * MODEL_MATRIX) d'une MultiMesh (celle du GridMap) n'a pas la pose de l'instance (vu : plus aucun fondu).
	ivec3 b = ivec3(round(centre - vec3(1.0)));
	vec3 f = clamp(p_monde - vec3(b) - vec3(0.5), vec3(0.0), vec3(1.0));
	int r[8];
	float w[8];
	int proprio = 999;
	for (int k = 0; k < 8; k++) {
		ivec3 o = ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1);
		r[k] = rang_en(b + o, 0);
		vec3 g = mix(vec3(1.0) - f, f, vec3(o));
		w[k] = g.x * g.y * g.z;
		if (r[k] >= 0 && r[k] < proprio) {
			proprio = r[k];
		}
	}
	if (proprio == 999) {
		discard;
	}
	float w_proprio = 0.0;
	float meilleur = 0.0;
	int autre = -1;
	for (int k = 0; k < 8; k++) {
		if (r[k] == proprio) {
			w_proprio += w[k];
		} else if (r[k] >= 0) {
			float part = 0.0;
			for (int j = 0; j < 8; j++) {
				if (r[j] == r[k]) {
					part += w[j];
				}
			}
			if (part > meilleur) {
				meilleur = part;
				autre = r[k];
			}
		}
	}
	// ⚠ LA TABLE A LE NOMBRE RÉEL DE COUCHES (2·N × N) : un rang hors d'elle ne se fond pas (un texelFetch hors de la
	// texture n'est pas défini).
	if (autre < 0 || max(proprio, autre) >= textureSize(table, 0).y) {
		discard;
	}
	vec4 ao1 = texelFetch(table, ivec2(2 * proprio, autre), 0);
	vec4 oa1 = texelFetch(table, ivec2(2 * autre, proprio), 0);
	if (ao1.r < 0.5 || oa1.r < 0.5) {
		discard;
	}
	vec4 ao2 = texelFetch(table, ivec2(2 * proprio + 1, autre), 0);
	vec4 oa2 = texelFetch(table, ivec2(2 * autre + 1, proprio), 0);
	float s = meilleur / (meilleur + w_proprio);
	int prioritaire = min(proprio, autre);
	float vote_autre = 0.0;
	bool peint = false;
	for (int k = 0; k < 8; k++) {
		int c = rang_en(b + ivec3(k & 1, (k >> 1) & 1, (k >> 2) & 1), 1);
		peint = peint || c >= 0;
		int couvrant = (c == proprio || c == autre) ? c : prioritaire;
		if (couvrant == autre) {
			vote_autre += w[k];
		}
	}
	float n = bruit3(p_monde * ao2.g);
	float h_proprio = dot(aspect(proprio, p_monde, n_monde).rgb, vec3(0.299, 0.587, 0.114));
	float h_autre = dot(aspect(autre, p_monde, n_monde).rgb, vec3(0.299, 0.587, 0.114));
	float a_autre = visible(ao1, ao2, s, h_proprio, n);
	float a_proprio = 1.0 - visible(oa1, oa2, 1.0 - s, h_autre, bruit3(p_monde * oa2.g));
	float a = vote_autre * a_autre + (1.0 - vote_autre) * a_proprio;
	if (a < 0.004) {
		discard;
	}
	vec3 couleur = aspect(autre, p_monde, n_monde).rgb;
	if (montrer_choix && peint) {
		couleur = mix(couleur, vec3(1.0, 0.85, 0.2), 0.35);
	}
	ALBEDO = couleur;
	ROUGHNESS = texelFetch(rep_params, ivec2(autre, 1), 0).y;
	ALPHA = a;
}
"""

const WIND := """
shader_type spatial;
render_mode world_vertex_coords, @CULL@;

uniform vec4 albedo : source_color = vec4(1.0);
uniform sampler2D tex_albedo : source_color, filter_linear_mipmap, repeat_enable;
uniform bool a_texture = false;
uniform bool couleur_sommet = false;
uniform float rugosite = 1.0;
uniform sampler2D tex_rugosite : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform vec4 canal_rugosite = vec4(0.0, 1.0, 0.0, 0.0);
uniform bool a_rugosite = false;
uniform float metal = 0.0;
uniform sampler2D tex_metal : hint_default_white, filter_linear_mipmap, repeat_enable;
uniform vec4 canal_metal = vec4(0.0, 0.0, 1.0, 0.0);
uniform bool a_metal = false;
uniform sampler2D tex_normale : hint_normal, filter_linear_mipmap, repeat_enable;
uniform bool a_normale = false;
uniform float force_normale = 1.0;
uniform float seuil_alpha = 0.5;
uniform vec2 sens_vent = vec2(1.0, 0.35);

// LE BALANCEMENT (`FE.balancement`, ligne à ligne).
void vertex() {
	float haut = INSTANCE_CUSTOM.y;
	if (haut > 0.0) {
		float h = clamp((VERTEX.y - INSTANCE_CUSTOM.x) / haut, 0.0, 1.0);
		float phase = INSTANCE_CUSTOM.z;
		float ampleur = INSTANCE_CUSTOM.w * haut * 0.05;
		float t = TIME;
		// le balancement : penché sous le vent, deux rafales qui ne se répètent pas ensemble
		float b = 0.35 + 0.6 * sin(t * 1.1 + phase) + 0.3 * sin(t * 2.3 + phase * 1.7);
		VERTEX.xz += normalize(sens_vent) * b * ampleur * h * h;
		// le frisson des feuilles, plus fort en haut
		VERTEX += NORMAL * sin(t * 7.0 + dot(VERTEX, vec3(2.1, 1.7, 2.9))) * 0.015 * INSTANCE_CUSTOM.w * h;
	}
}

void fragment() {
	vec4 c = albedo;
	if (a_texture) { c *= texture(tex_albedo, UV); }
	if (couleur_sommet) { c *= COLOR; }
	ALBEDO = c.rgb;
	@ALPHA@
	ROUGHNESS = rugosite * (a_rugosite ? dot(texture(tex_rugosite, UV), canal_rugosite) : 1.0);
	METALLIC = metal * (a_metal ? dot(texture(tex_metal, UV), canal_metal) : 1.0);
	if (a_normale) { NORMAL_MAP = texture(tex_normale, UV).rgb; NORMAL_MAP_DEPTH = force_normale; }
}
"""

const WATER_STYLIZED := """
shader_type spatial;
render_mode cull_disabled, unshaded, depth_draw_always;

uniform sampler2D depth_tex : hint_depth_texture, filter_linear;

uniform vec3 bleu_clair : source_color = vec3(0.22, 0.53, 0.74);
uniform vec3 bleu_fonce : source_color = vec3(0.06, 0.22, 0.45);
uniform vec3 bleu_frange : source_color = vec3(0.34, 0.61, 0.74);
uniform vec3 couleur_ligne : source_color = vec3(0.96, 0.99, 1.0);
uniform float seuil0 = 0.15;
uniform float seuil1 = 0.72;
uniform float vitesse_riviere = 1.6;
uniform float vitesse_dormante = 0.25;
uniform float force_caustiques = 0.6;
uniform vec3 caustique_couleur : source_color = vec3(0.92, 1.0, 0.96);
uniform float caustique_echelle = 1.15;
uniform float clapot = 0.03;

varying vec3 v_monde;
varying vec2 v_courant;
varying float v_genre;
varying vec3 v_n;
varying float v_mousse;

float bruit(vec2 p) {
	return fract(sin(dot(floor(p), vec2(127.1, 311.7))) * 43758.5453);
}

float bruit_lisse(vec2 p) {
	vec2 i = floor(p);
	vec2 f = smoothstep(0.0, 1.0, fract(p));
	float a = bruit(i);
	float b = bruit(i + vec2(1.0, 0.0));
	float c = bruit(i + vec2(0.0, 1.0));
	float d = bruit(i + vec2(1.0, 1.0));
	return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}


float caustique(vec2 p, float t, float pied) {
	vec2 q = p + 0.35 * vec2(sin(p.y * 1.3 + t), cos(p.x * 1.1 - t * 0.9));
	mat2 rot = mat2(vec2(0.80, 0.60), vec2(-0.60, 0.80));
	float v = 0.0;
	float w = 0.0;
	float f = 1.0;
	for (int i = 0; i < 3; i++) {
		q = rot * q * 1.62;
		f *= 1.62;
		float a = 1.0 - smoothstep(0.5, 1.3, pied * f);
		v += a * sin(q.x + t * (1.0 + float(i) * 0.27)) * cos(q.y - t * (0.8 + float(i) * 0.19));
		w += a;
	}
	float crete = clamp(1.0 - abs(v / max(w, 1e-3)), 0.0, 1.0);
	float net = 1.0 - smoothstep(0.15, 0.40, pied * f);
	float c = pow(crete, mix(1.5, 4.0, net)) * mix(0.64, 1.0, net);
	return mix(0.44, c, smoothstep(0.0, 0.6, w * 0.3333333));
}



vec3 motif_cascade(vec2 uv, float t, float n_haut, float mousse) {
	float y = uv.y;
	float a = bruit_lisse(vec2(uv.x * 4.5, (y + t * 2.2) * 0.35));
	float b = bruit_lisse(vec2(uv.x * 11.0 + 7.3, (y + t * 3.1) * 0.75));
	float c = bruit_lisse(vec2(uv.x * 27.0 + 1.7, (y + t * 4.3) * 1.9));
	float filets = clamp(smoothstep(0.42, 0.82, a) * 0.5 + smoothstep(0.5, 0.88, b) * 0.45
		+ smoothstep(0.6, 0.9, c) * 0.4, 0.0, 1.0);
	float lisse = smoothstep(0.45, 0.85, n_haut) * (1.0 - mousse);
	filets *= 1.0 - lisse * 0.9;
	float bouillon = bruit_lisse(vec2(uv.x * 3.5 + t * 0.25, (y - t * 0.8) * 2.6)) * 0.6
		+ bruit_lisse(vec2(uv.x * 9.0 - t * 0.4, (y - t * 1.3) * 6.5)) * 0.4;
	float e = smoothstep(0.2, 0.7, mousse + (bouillon - 0.5) * 0.75);
	return vec3(filets, e, lisse);
}


void vertex() {
	v_monde = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
	v_courant = COLOR.rg * 2.0 - 1.0;
	v_genre = COLOR.b;
	v_n = (MODEL_MATRIX * vec4(NORMAL, 0.0)).xyz;
	v_mousse = COLOR.a;
	// Le clapot : une ondulation légère des nappes, jamais des cascades.
	// Le clapot, cascades comprises (voir le premier preset).
	VERTEX.y += clapot * sin(v_monde.z * 0.55 + v_monde.x * 0.85 + TIME * 1.9);
}

void fragment() {
	float t = TIME;
	// ⚠ TOUT CE QUI DÉRIVE (fwidth, dFdx) EST CALCULÉ HORS DE TOUT BRANCHEMENT PAR PIXEL : une dérivée prise
	// dans un `if` non uniforme lit des voies inactives du quad.
	float dz = texture(depth_tex, SCREEN_UV).x;
	vec4 vue = INV_PROJECTION_MATRIX * vec4(SCREEN_UV * 2.0 - 1.0, dz, 1.0);
	vec3 pos_fond = (INV_VIEW_MATRIX * vec4(vue.xyz / vue.w, 1.0)).xyz;
	float prof = v_monde.y - pos_fond.y;
	float ps = prof / 1.9;
	float d_rive = abs(ps) / max(fwidth(ps), 1e-5);
	vec2 cp = v_monde.xz * caustique_echelle;
	float pied = max(length(dFdx(cp)), length(dFdy(cp)));

	bool courante = v_genre > 0.25;
	vec2 flux = length(v_courant) > 0.1 ? normalize(v_courant) : vec2(0.6, 0.8);
	float defile = t * (courante ? vitesse_riviere : vitesse_dormante);

	// --- dégradé : grève → bleu clair → bleu profond
	float p = clamp(ps, 0.0, 1.0);
	vec3 c = mix(bleu_frange, bleu_clair, smoothstep(0.0, seuil0, p));
	c = mix(c, bleu_fonce, smoothstep(seuil0 * 0.8, seuil1, p));

	// --- caustiques, dans le peu profond seulement
	float reseau = caustique(cp, t * 0.85, pied);
	float lum = smoothstep(0.30, 0.42, reseau) * 0.42 + smoothstep(0.62, 0.72, reseau) * 0.58;
	c = mix(c, caustique_couleur, lum * (1.0 - smoothstep(0.18, 0.62, p)) * force_caustiques);

	// --- la houle, en marches, qui défile dans le sens du courant
	vec2 n = vec2(-flux.y, flux.x);
	vec2 q = vec2(dot(v_monde.xz, n), (dot(v_monde.xz, flux) - defile) * (courante ? 0.6 : 0.17));
	float houle = 0.52 * (sin(q.x * 1.15 + q.y * 2.3) + 0.65 * sin(q.x * 2.10 - q.y * 1.7 + 1.3)
		+ 0.40 * sin(q.x * 0.55 + q.y * 3.4 - 0.7));
	float marche = floor(clamp(houle * 0.5 + 0.5, 0.0, 0.999) * 3.0) / 2.0;
	float force = courante ? 0.9 : 0.35;
	float ampleur = 0.10 + 0.13 * force;
	float trait = smoothstep(0.86, 1.02, houle);
	float furtif = step(0.40, bruit(vec2(q.x * 0.30, floor(q.y * 0.6))));
	float lignes = trait * furtif * (0.35 + 0.65 * force);

	// --- le liseré de rive et le contact
