; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Story of Knil"
config/description="Un action-aventure vu de dessus : Knil, un anti-héros sans aucune vertu, sauve le monde quand même."
config/version="0.1.0"
run/main_scene="res://scenes/livre.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.07, 0.06, 0.05, 1)
boot_splash/image="res://assets/icone/knil_splash.png"
boot_splash/fullsize=false
config/icon="res://assets/icone/knil_icone.png"
config/windows_native_icon="res://assets/icone/knil_icone.ico"

[autoload]

EventBus="*res://core/event_bus.gd"
GameClock="*res://core/game_clock.gd"
GameState="*res://core/game_state.gd"
SaveSystem="*res://core/save_system.gd"

[debug]

settings/stdout/print_fps=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/mode=3
window/hdr/request_hdr_output=true
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/marchingblocks_paint/plugin.cfg")
