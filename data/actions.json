{
  "_doc": "Les actions de la barre. when = conditions (toutes) ; weight + weight_mods = la chance d'apparaître ; effects = ce que le choix change. Langage : core/rules.gd. icon = glyphe provisoire de la case carrée (remplacé plus tard par une image : champ icon_path).",
  "actions": [
    {
      "id": "mepriser", "label": "Mépriser", "icon": "✕", "category": "mepris", "order": 99,
      "effects": [
        {"op": "add", "path": "target.disposition", "value": -1},
        {"op": "add", "path": "player.identity.reputation", "value": -0.5}
      ]
    },
    {
      "id": "aider", "label": "Aider", "icon": "✚", "category": "aide", "order": 10, "weight": 3,
      "when": [{"path": "target.problem.resolved", "op": "==", "value": false}],
      "weight_mods": [{"when": [{"path": "history.disposition", "op": ">", "value": 0}], "mul": 1.5}],
      "effects": [
        {"op": "resolve_problem"},
        {"op": "add", "path": "target.disposition", "value": 2},
        {"op": "add", "path": "player.identity.reputation", "value": 1}
      ]
    },
    {
      "id": "soigner", "label": "Soigner", "icon": "♥", "category": "aide", "order": 11, "weight": 4,
      "when": [
        {"path": "target.problem.resolved", "op": "==", "value": false},
        {"path": "target.problem.type", "op": "in", "value": ["maladie", "blessure"]}
      ],
      "effects": [
        {"op": "resolve_problem"},
        {"op": "add", "path": "target.disposition", "value": 3},
        {"op": "add", "path": "player.identity.reputation", "value": 1.5}
      ]
    },
    {
      "id": "reparer", "label": "Réparer", "icon": "⚒", "category": "aide", "order": 12, "weight": 4,
      "when": [
        {"path": "target.problem.resolved", "op": "==", "value": false},
        {"path": "target.problem.type", "op": "in", "value": ["casse", "panne"]}
      ],
      "effects": [{"op": "resolve_problem"}, {"op": "add", "path": "target.disposition", "value": 2}]
    },
    {
      "id": "assainir", "label": "Assainir", "icon": "❀", "category": "aide", "order": 13, "weight": 4,
      "when": [
        {"path": "target.kind", "op": "==", "value": "lieu"},
        {"path": "target.problem.resolved", "op": "==", "value": false},
        {"path": "target.problem.type", "op": "in", "value": ["pollution", "secheresse", "incendie"]}
      ],
      "effects": [{"op": "resolve_problem"}, {"op": "add", "path": "player.identity.reputation", "value": 1}]
    },
    {
      "id": "donner", "label": "Donner 5 or", "icon": "◎", "category": "aide", "order": 20, "weight": 2,
      "when": [
        {"path": "target.kind", "op": "==", "value": "personne"},
        {"path": "player.wealth.gold", "op": ">=", "value": 5}
      ],
      "weight_mods": [
        {"when": [{"path": "target.tags", "op": "has", "value": "pauvre"}], "mul": 3},
        {"when": [{"path": "target.problem.type", "op": "==", "value": "pauvrete"}], "mul": 3}
      ],
      "effects": [
        {"op": "add", "path": "player.wealth.gold", "value": -5},
        {"op": "add", "path": "target.disposition", "value": 2}
      ]
    },
    {
      "id": "ecouter", "label": "Écouter", "icon": "…", "category": "neutre", "order": 5, "weight": 2,
      "when": [{"path": "target.kind", "op": "==", "value": "personne"}],
      "weight_mods": [{"when": [{"path": "history.days_since_last", "op": "==", "value": 0}], "mul": 0.3}],
      "effects": [{"op": "add", "path": "target.disposition", "value": 0.5}]
    },
    {
      "id": "commercer", "label": "Commercer", "icon": "⇄", "category": "neutre", "order": 30, "weight": 3,
      "when": [
        {"path": "target.tags", "op": "has", "value": "marchand"},
        {"path": "time.phase", "op": "in", "value": ["aube", "jour", "crepuscule"]}
      ],
      "effects": []
    },
    {
      "id": "louer_chambre", "label": "Louer une chambre", "icon": "⌂", "category": "neutre", "order": 31, "weight": 5,
      "when": [
        {"path": "target.tags", "op": "has", "value": "aubergiste"},
        {"path": "player.wealth.gold", "op": ">=", "value": 10}
      ],
      "effects": [
        {"op": "add", "path": "player.wealth.gold", "value": -10},
        {"op": "stamp", "path": "flags.chambre_louee_jour"}
      ]
    },
    {
      "id": "demander_hospitalite", "label": "Demander l'hospitalité", "icon": "☾", "category": "neutre", "order": 32, "weight": 2,
      "when": [
        {"path": "target.kind", "op": "==", "value": "personne"},
        {"path": "target.tags", "op": "has", "value": "habitant"},
        {"path": "time.phase", "op": "in", "value": ["crepuscule", "nuit"]},
        {"path": "history.disposition", "op": ">=", "value": 2}
      ],
      "effects": [{"op": "push", "path": "player.wealth.properties", "value": "hospitalite"}]
    },
    {
      "id": "voler", "label": "Voler", "icon": "✋", "category": "mal", "order": 60, "weight": 1,
      "when": [
        {"path": "target.kind", "op": "==", "value": "personne"},
        {"path": "target.tags", "op": "not_has", "value": "pauvre"}
      ],
      "weight_mods": [
        {"when": [{"path": "time.phase", "op": "==", "value": "nuit"}], "mul": 3},
        {"when": [{"path": "player.wealth.gold", "op": "<", "value": 5}], "mul": 2}
      ],
      "effects": [
        {"op": "add", "path": "player.wealth.gold", "value": 8},
        {"op": "add", "path": "target.disposition", "value": -4},
        {"op": "add", "path": "player.identity.reputation", "value": -2}
      ]
    },
    {
      "id": "denoncer", "label": "Dénoncer", "icon": "⚑", "category": "neutre", "order": 61, "weight": 2,
      "when": [
        {"path": "target.tags", "op": "has", "value": "criminel"},
        {"path": "place.region_type", "op": "in", "value": ["ville", "capitale"]}
      ],
      "effects": [{"op": "add", "path": "target.disposition", "value": -5}, {"op": "add", "path": "player.identity.reputation", "value": 1}]
    },
    {
      "id": "prier", "label": "Se recueillir", "icon": "✧", "category": "neutre", "order": 40, "weight": 3,
      "when": [{"path": "target.tags", "op": "has", "value": "sacre"}],
      "effects": []
    }
  ]
}
